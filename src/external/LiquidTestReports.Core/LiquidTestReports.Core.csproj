<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)..\LiquidTestReports.Core.PackageReferences.props"/>
  <PropertyGroup>
    <AssemblyName>LiquidTestReports.Core</AssemblyName>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <RepositoryUrl>https://github.com/kurtmkurtm/LiquidTestReports</RepositoryUrl>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <RootNamespace>LiquidTestReports.Core</RootNamespace>
    <Authors>Kurt Murrell</Authors>
    <Product>LiquidTestReports.Core</Product>
    <Copyright>2024</Copyright>
    <Description>Core library for creating custom VS Test loggers with liquid template support</Description>
  </PropertyGroup>
</Project>
