<Project>
  <!--
    This file maintains shared package dependencies to ensure that the transitive
    dependencies of the vendored LiquidTestReports.Core are correctly propagated and
    synchronized into the final public NuGet package dependencies (.nuspec).
  -->
  <ItemGroup>
    <PackageReference Include="DotLiquid" Version="2.3.197" />
    <PackageReference Include="Microsoft.TestPlatform.ObjectModel" Version="18.0.0" />
    <PackageReference Include="NuGet.Frameworks" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.StartsWith('netstandard'))">
    <PackageReference Update="NuGet.Frameworks" Version="6.14.3" /> <!-- 7.x.x does not support .NET Standard -->
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>
</Project>
